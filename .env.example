# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会提交。

# ---- LLM：OpenAI 兼容接口（默认阿里云百炼 DashScope）----
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key-here

# Agent 1 Analyzer（意图解析 / 规划 / LLM-as-judge），型号待定
ANALYZER_MODEL=your-analyzer-model
# Agent 2 Coder（SQL 生成 / 自修正），型号待定
CODER_MODEL=your-coder-model

# 可选：某个角色单独走另一个服务（如本地 vLLM），不填则沿用上面的 LLM_*
# CODER_BASE_URL=http://localhost:8000/v1
# CODER_API_KEY=EMPTY

# ---- 向量检索 ----
# bge=本地 BGE-M3（需要安装 local-embedding 依赖并下载模型）；api=OpenAI 兼容 embeddings
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
# 使用 API 时（如 DashScope text-embedding-v3）：
# EMBEDDING_BACKEND=api
# EMBEDDING_API_MODEL=text-embedding-v3
# EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-...

# 可选：单次请求超时（秒）与 SDK 自动重试次数
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
